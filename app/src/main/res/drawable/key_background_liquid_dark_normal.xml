<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Diffuse base shadow to decouple keycaps from background panel -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="@color/liquid_dark_key_shadow" />
        </shape>
    </item>

    <!-- Smoky dark acrylic body with vertical gradient and specular beveled rim -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/liquid_dark_key_normal_start"
                android:endColor="@color/liquid_dark_key_normal_end"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/liquid_dark_key_specular_stroke" />
        </shape>
    </item>

    <!-- Subtle specular top sheen highlight (#25FFFFFF) -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="22dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="10dp"
                android:topRightRadius="10dp"
                android:bottomLeftRadius="2dp"
                android:bottomRightRadius="2dp" />
            <gradient
                android:angle="270"
                android:startColor="@color/liquid_dark_key_specular_top"
                android:endColor="#00FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
