<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floating_control_bar"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:paddingBottom="4dp"
    android:visibility="gone"
    android:background="@android:color/transparent">

    <ImageButton
        android:id="@+id/btn_floating_resize"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_arrow_horizontal"
        android:contentDescription="@string/label_resize_onehanded_key" />

    <FrameLayout
        android:id="@+id/floating_drag_handle_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true">

        <View
            android:id="@+id/floating_drag_handle_pill"
            android:layout_width="64dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:background="@drawable/floating_drag_handle_bg" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btn_floating_dock"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:padding="6dp"
        android:scaleType="fitCenter"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_keyboard_dock"
        android:contentDescription="@string/floating" />

</LinearLayout>
