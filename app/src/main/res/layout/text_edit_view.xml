<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/text_edit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Header bar -->
    <LinearLayout
        android:id="@+id/text_edit_header"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="4dp">

        <ImageButton
            android:id="@+id/text_edit_btn_close"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close_history"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_close" />

        <TextView
            android:id="@+id/text_edit_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/text_edit"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/text_edit_btn_undo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/undo"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_undo" />

        <ImageButton
            android:id="@+id/text_edit_btn_redo"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/redo"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_redo" />

        <ImageButton
            android:id="@+id/text_edit_btn_paste_header"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="4dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/paste"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/sym_keyboard_paste" />

        <ImageButton
            android:id="@+id/text_edit_btn_select_all_header"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/select_all"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_select_all" />

    </LinearLayout>

    <!-- Main 3-column body -->
    <LinearLayout
        android:id="@+id/text_edit_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Column 1: Selection & Clipboard Tools -->
        <LinearLayout
            android:id="@+id/text_edit_col_left"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:orientation="vertical"
            android:padding="2dp">

            <FrameLayout
                android:id="@+id/text_edit_btn_select_word"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:clickable="true"
                android:focusable="true">
                <ImageButton
                    android:id="@+id/text_edit_icon_select_word"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:focusable="false"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_select" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/text_edit_btn_cut"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:clickable="true"
                android:focusable="true">
                <ImageButton
                    android:id="@+id/text_edit_icon_cut"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:focusable="false"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sym_keyboard_cut" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/text_edit_btn_copy"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:clickable="true"
                android:focusable="true">
                <ImageButton
                    android:id="@+id/text_edit_icon_copy"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:focusable="false"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sym_keyboard_copy" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/text_edit_btn_paste"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:clickable="true"
                android:focusable="true">
                <ImageButton
                    android:id="@+id/text_edit_icon_paste"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:focusable="false"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sym_keyboard_paste" />
            </FrameLayout>

        </LinearLayout>

        <!-- Column 2: 3x3 D-Pad Navigation -->
        <LinearLayout
            android:id="@+id/text_edit_col_center"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.6"
            android:orientation="vertical"
            android:padding="2dp">

            <!-- D-Pad Row 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/text_edit_btn_home"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageButton
                        android:id="@+id/text_edit_icon_home"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="false"
                        android:focusable="false"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_to_start" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/text_edit_btn_up"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageButton
                        android:id="@+id/text_edit_icon_up"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="false"
                        android:focusable="false"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_dpad_up" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/text_edit_btn_end"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageButton
                        android:id="@+id/text_edit_icon_end"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="false"
                        android:focusable="false"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_to_end" />
                </FrameLayout>

            </LinearLayout>

            <!-- D-Pad Row 2 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/text_edit_btn_left"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageButton
                        android:id="@+id/text_edit_icon_left"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="false"
                        android:focusable="false"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_dpad_left" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/text_edit_btn_select_all"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageButton
                        android:id="@+id/text_edit_icon_select_all"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="false"
                        android:focusable="false"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_select_all" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/text_edit_btn_right"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageButton
                        android:id="@+id/text_edit_icon_right"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="false"
                        android:focusable="false"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_dpad_right" />
                </FrameLayout>

            </LinearLayout>

            <!-- D-Pad Row 3 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/text_edit_btn_page_up"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageButton
                        android:id="@+id/text_edit_icon_page_up"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="false"
                        android:focusable="false"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_page_start" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/text_edit_btn_down"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageButton
                        android:id="@+id/text_edit_icon_down"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="false"
                        android:focusable="false"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_dpad_down" />
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/text_edit_btn_page_down"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_margin="2dp"
                    android:clickable="true"
                    android:focusable="true">
                    <ImageButton
                        android:id="@+id/text_edit_icon_page_down"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:clickable="false"
                        android:focusable="false"
                        android:padding="8dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_page_end" />
                </FrameLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Column 3: Word Jumps & Actions -->
        <LinearLayout
            android:id="@+id/text_edit_col_right"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.0"
            android:orientation="vertical"
            android:padding="2dp">

            <FrameLayout
                android:id="@+id/text_edit_btn_word_left"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:clickable="true"
                android:focusable="true">
                <ImageButton
                    android:id="@+id/text_edit_icon_word_left"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:focusable="false"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_word_left" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/text_edit_btn_word_right"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:clickable="true"
                android:focusable="true">
                <ImageButton
                    android:id="@+id/text_edit_icon_word_right"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:focusable="false"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_word_right" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/text_edit_btn_delete"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:clickable="true"
                android:focusable="true">
                <ImageButton
                    android:id="@+id/text_edit_icon_delete"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:focusable="false"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sym_keyboard_delete_rounded" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/text_edit_btn_enter"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_margin="2dp"
                android:clickable="true"
                android:focusable="true">
                <ImageButton
                    android:id="@+id/text_edit_icon_enter"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clickable="false"
                    android:focusable="false"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sym_keyboard_return_rounded" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
